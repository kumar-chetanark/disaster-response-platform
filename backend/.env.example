PROJECT_NAME="Disaster Response Platform API"
ENVIRONMENT="production"
DEBUG=False
DEMO_MODE=True

# Database (Supabase PostgreSQL / SQLite fallback)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DBNAME]
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase Auth / SDK credentials (placeholders)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Explicit CORS Allowlist (comma-separated or JSON list)
ALLOWED_ORIGINS=["http://localhost:3000", "https://disaster-response-platform-eta.vercel.app"]
